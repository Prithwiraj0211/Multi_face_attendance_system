# Multi-Face AI Attendance Recognition System Environment Settings

# Security & Secrets
SECRET_KEY=super-secret-key-change-this-for-production-visionpass-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin User Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Database Connection
# To use PostgreSQL: Provide your local or cloud (Supabase / Neon / AWS RDS) Postgres URL
# Example: postgresql://postgres:postgres@localhost:5432/attendance_db
# If PostgreSQL is not installed or unreachable, the system automatically falls back to local SQLite (data/attendance.db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_db

# Hardware Camera Configuration
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
CAMERA_FPS=30

# AI Recognition Thresholds
# SFace cosine similarity threshold (Standard is 0.363; values >= 0.38 represent matching identity)
FACE_MATCH_THRESHOLD=0.38
FACE_DETECTOR_CONF_THRESHOLD=0.60

# Attendance Logic
# Cooldown period in seconds before the same employee can punch again (debounce spam prevention)
PUNCH_COOLDOWN_SECONDS=300
AUTO_CHECKOUT_HOURS=12
